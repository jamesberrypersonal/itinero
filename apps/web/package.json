{
  "name": "@itinero/web",
  "version": "0.1.0",
  "private": true,
  "description": "The web app travellers use on a computer or a phone, including reading a trip with no connection (docs/spec/web/shell.md)",
  "license": "SEE LICENSE IN ../../LICENSE",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --project . && tsc --project tsconfig.sw.json",
    "build": "vite build",
    "build-rules": "node scripts/build-rules.ts",
    "dev": "vite",
    "test": "tsc --project . && tsc --project tsconfig.sw.json && node --test \"test/unit/**/*.test.ts\" && playwright test",
    "test:unit": "node --test \"test/unit/**/*.test.ts\"",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@itinero/trip-time": "0.1.0",
    "preact": "11.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  },
  "engines": {
    "node": ">=24"
  }
}
